{
  "receipt_schema_version": 2,
  "run_id": "{UTC timestamp}-iteration-{NN}",
  "project": "{project name}",
  "iteration": 0,
  "evaluator_agent_id": "{agent ID returned by the orchestrator}",
  "evaluator_nickname": "{optional nickname}",
  "evaluation_kind": "independent_llm",
  "evaluation_scope": "web_app | non_ui",
  "traceability_required": true,
  "ui_evaluation": {
    "required": true,
    "tool": "Playwright",
    "status": "pending | completed | not_required",
    "evidence_file": "playwright-evidence.md"
  },
  "spawned_by": "orchestrator",
  "context_isolation": "fresh_context",
  "allowed_inputs": [
    "artifact",
    "run-instructions",
    "project-requirements.md",
    "acceptance-criteria.md",
    "eval-cases.md",
    "eval-profile.md",
    "traceability.md (when present)"
  ],
  "excluded_inputs": [
    "implementation chat history",
    "implementation rationale",
    "unfinished-work explanations"
  ],
  "evaluated_commit_sha": "Git commit SHA evaluated (or 'unavailable' outside Git)",
  "requirements_hash": "SHA-256 of project-requirements.md at evaluation time",
  "eval_cases_hash": "SHA-256 of evaluation/eval-cases.md at evaluation time",
  "artifact_hashes": {
    "relative/path/to/artifact": "SHA-256"
  },
  "evaluator_model": "model identifier",
  "evaluator_prompt_version": "prompt-v1",
  "rubric_version": "rubric-v1",
  "temperature": 0,
  "started_at": "YYYY-MM-DDTHH:MM:SSZ",
  "completed_at": "YYYY-MM-DDTHH:MM:SSZ",
  "verdict": "Pass | Fix | Needs Review"
}
